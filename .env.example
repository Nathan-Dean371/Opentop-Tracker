# OpenTop Tracker Environment Variables

# Server Port (Railway will set this automatically)
PORT=3100

# Admin Panel Authentication
# IMPORTANT: Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=opentop123

# Data storage directory (set to Railway volume mount path in production)
# If using Railway Volume, set to: /data
DATA_DIR=/data

# Location ingestion safeguards (prevents old queued OwnTracks points from overriding fresh positions)
# Drop any point where (now - device tst) exceeds this many seconds
LOCATION_MAX_STALE_SECONDS=900
# Allow minor out-of-order jitter without dropping
LOCATION_MAX_OUT_OF_ORDER_SECONDS=30

# OwnTracks HTTP ingestion (disabled by default; set true only when needed)
OWNTRACKS_HTTP_ENABLED=false

# MQTT ingestion (optional; leave MQTT_BROKER_URL empty to disable MQTT)
MQTT_BROKER_URL=
MQTT_TOPIC=owntracks/+/+
MQTT_CLIENT_ID=opentop-backend
MQTT_USERNAME=
MQTT_PASSWORD=
# Broker certificate verification (default true). For a private CA, set MQTT_CA_CERT
# to the ca.crt PEM contents or a file path (public certificate only, never a key).
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_CA_CERT=
